# Copy to .env.local and fill in. Never commit real keys.

# YouCam API key: https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# DEMO_MODE=1 replays the recorded session in public/demo/look/ (0 units).
# Use it for the judges' link and for UI work.
DEMO_MODE=1

# RECORD_DEMO=1 (with DEMO_MODE=0) saves a real session to public/demo/look/.
RECORD_DEMO=0

# Max YouCam units this project may spend in total (app + week1 CLI). Ledger: .data/units.json
UNIT_BUDGET=300
