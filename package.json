{
  "name": "steal-the-look",
  "version": "0.1.0",
  "private": true,
  "description": "Steal the Look, for Less: see any lipstick look on your face and get the best-matching shade for less, proven on your own lips. Built on YouCam APIs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "week1": "node --env-file=.env.local --conditions=react-server --import tsx scripts/week1.ts",
    "postinstall": "node scripts/setup-mediapipe.mjs",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "build:check": "NEXT_DIST_DIR=.next-build next build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
